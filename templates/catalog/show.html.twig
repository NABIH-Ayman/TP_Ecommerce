{% extends 'layout.html.twig' %}
{% block content %}
    {{ include('partials/_jumbotron.html.twig') }}

    <div class="row mt-4">
        <div class="col-9">
            <div class="card mb-4">
                <div class="card-body">
                    <h3 class="card-title">{{ course.name | upper }}</h3>
                    <h6 class="card-subtitle mb-2 text-muted">{{ course.category.name }} — par {{ course.author.name }}</h6>
                    <p><strong>Prix :</strong>
                        {% if course.price > 0 %}
                            {{ course.price | number_format(2, ',', ' ') }} DH
                        {% else %}
                            Gratuit
                        {% endif %}
                    </p>
                    <p><strong>Synopsis :</strong> {{ course.synopsis }}</p>
                    <hr>
                    <p>{{ course.description }}</p>
                </div>
            </div>
        </div>
        <div class="col-3">
            <div class="alert alert-info">
                Liste des cours similaires... (À venir)
            </div>
        </div>
    </div>
{% endblock %}
