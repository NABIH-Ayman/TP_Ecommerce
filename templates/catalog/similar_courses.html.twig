<div class="card">
    <div class="card-header bg-primary text-white">
        Vous aimerez aussi
    </div>
    <div class="list-group list-group-flush">
        {% for slug, course in courses %}
            <a href="{{ path('app_catalog_view', {slug: slug}) }}" class="list-group-item list-group-item-action">
                <div class="d-flex w-100 justify-content-between">
                    <h6 class="mb-1">{{ course.name }}</h6>
                </div>
                <small class="text-muted">{{ course.author.name }}</small>
            </a>
        {% endfor %}
    </div>
</div>
