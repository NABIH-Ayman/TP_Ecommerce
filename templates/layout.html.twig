{# templates/layout.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}E-learning{% endblock %}</title>
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/bootstrap.min.css') }}"/>
        <link rel="stylesheet" href="{{ asset('css/style.css') }}"/>
    {% endblock %}
</head>
<body class="d-flex flex-column min-vh-100">
{# --- HEADER / NAVBAR --- #}
<nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="{{ path('app_page') }}">
            <img src="{{ asset('images/logo.png') }}" alt="EHEI" width="50"/>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarColor01">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link active" href="{{ path('app_page') }}">Accueil</a>
                </li>
                <li class="nav-item">
                    {# On mettra le lien catalogue plus tard #}
                    <a class="nav-link" href="#">Catalogue des cours</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Profil</a>
                    <div class="dropdown-menu">
                        {% if app.user is not null %}
                            <a class="dropdown-item" href="{{ path('app_security') }}">Mon Profil</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="#">Se déconnecter</a>
                        {% else %}
                            <a class="dropdown-item" href="#">Se connecter</a>
                        {% endif %}
                    </div>
                </li>
            </ul>
            <form class="d-flex">
                <input class="form-control me-sm-2" type="search" placeholder="Search">
                <button class="btn btn-secondary my-2 my-sm-0" type="submit">Search</button>
            </form>
        </div>
    </div>
</nav>

{# --- CONTENU DE LA PAGE --- #}
<div class="container mt-4">
    {% block content %}{% endblock %}
</div>

{# --- FOOTER --- #}
<footer class="py-2 mt-4 bg-light border-top mt-auto">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-3 mb-2">
                <h6>Section</h6>
                <ul class="nav flex-column small">
                    <li class="nav-item mb-1"><a href="#" class="nav-link p-0 text-body-secondary">Home</a></li>
                    <li class="nav-item mb-1"><a href="#" class="nav-link p-0 text-body-secondary">Features</a></li>
                </ul>
            </div>
            <div class="col-md-5 ms-auto text-end">
                <p class="text-body-secondary small mt-2 mb-0">© 2025 Company, Inc.</p>
            </div>
        </div>
    </div>
</footer>

{% block javascripts %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.8/js/bootstrap.bundle.min.js"></script>
{% endblock %}
</body>
</html>
